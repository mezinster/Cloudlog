<?xml version="1.0"?>
<ruleset name="Cloudlog">
	<description>PHP cross-version compatibility check (dev runs 7.4, production runs 8.2).</description>

	<file>application</file>
	<file>src</file>
	<file>index.php</file>

	<exclude-pattern>application/third_party/*</exclude-pattern>
	<exclude-pattern>application/cache/*</exclude-pattern>
	<exclude-pattern>application/logs/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-8.2"/>
	<rule ref="PHPCompatibility"/>
</ruleset>
