# =============================================================================
# Cloudlog Portainer Stack — Environment Variables
# =============================================================================
# Copy this into Portainer's "Environment variables" section (or load as a
# .env file) when deploying the stack. All variables have sensible defaults.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=cloudlog
MYSQL_USER=cloudlog
MYSQL_PASSWORD=cloudlogpassword
MYSQL_HOST=db
MYSQL_PORT=3306

# ── Cloudlog Application ────────────────────────────────────────────────────
# Maidenhead grid locator for your station (used for bearing/distance calc)
BASE_LOCATOR=IO91WM

# Full URL where Cloudlog will be accessible (include https:// if using Traefik)
WEBSITE_URL=http://localhost

# ── Networking ───────────────────────────────────────────────────────────────
# Host port to bind for direct HTTP access (ignored when using Traefik)
CLOUDLOG_HTTP_PORT=80

# ── Traefik Integration (optional) ──────────────────────────────────────────
# Set to "true" to activate Traefik reverse-proxy labels for automatic HTTPS
CLOUDLOG_TRAEFIK_ENABLE=false

# Your domain name — must point to the Traefik host's IP
CLOUDLOG_DOMAIN=cloudlog.local
